<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
    <title>Spring Bunny Hop Open House Tour</title>
    
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="css/style.css">
</head>
<body class="bg-slate-50">

    <header class="fixed top-0 left-0 right-0 z-[1000] bg-white/90 backdrop-blur-md shadow-sm p-4 flex justify-between items-center">
        <div>
            <h1 class="text-xl font-bold text-teal-800 uppercase tracking-widest">Spring Bunny Hop</h1>
            <p class="text-xs text-gray-500 italic">Sat 4/11 | 1-3 PM</p>
        </div>
        <img src="https://upload.wikimedia.org/wikipedia/commons/2/22/Compass_Inc._logo.svg" alt="Compass" class="h-6">
    </header>

    <div id="map" class="h-screen w-full"></div>

    <button id="locate-btn" class="fixed bottom-8 right-6 z-[1000] bg-white p-3 rounded-full shadow-lg hover:bg-teal-50 transition-colors">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#115e59" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
    </button>

    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script src="js/data.js"></script>
    <script src="js/map.js"></script>
</body>
</html>
